parks.example.com {
	encode zstd gzip
	reverse_proxy 127.0.0.1:8080 {
		# Caddy recognises text/event-stream and flushes SSE without response buffering.
		stream_timeout 6h
	}
	request_body {
		max_size 128MB
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		-Server
	}
}
