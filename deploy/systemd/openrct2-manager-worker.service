[Unit]
Description=OpenRCT2 Server Manager archive and transfer worker
Wants=network-online.target
After=network-online.target openrct2-manager-web.service

[Service]
Type=simple
User=openrct2-manager
Group=openrct2-manager
EnvironmentFile=/etc/openrct2-manager/manager.env
WorkingDirectory=/opt/openrct2-manager
ExecStart=/opt/openrct2-manager/venv/bin/python -m openrct2_manager.worker
Restart=on-failure
RestartSec=5
TimeoutStopSec=1800
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/openrct2-manager /var/lib/openrct2 /var/log/openrct2-manager
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
UMask=0027

[Install]
WantedBy=multi-user.target

